{
  "expo": {
    "name": "GigGuard",
    "slug": "gigguard",
    "scheme": "gigguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/logoFinal.png",
    "splash": {
      "image": "./assets/logoFinal.png",
      "backgroundColor": "#0a0e1a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GigGuard needs your location to calculate zone-specific insurance premiums based on local weather risk."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoFinal.png",
        "backgroundColor": "#0a0e1a"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.geek_aditya.gigguard"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GigGuard needs your location to calculate zone-specific insurance premiums based on local weather risk."
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "8c845190-31ce-4633-8188-36c4a8c78bba"
      }
    }
  }
}
